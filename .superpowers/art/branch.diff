+                .iter()
+                .map(|spark| spark.velocity.length())
+                .collect()
+        };
+        let before = speeds(&world);
+
+        tick_lightning(&mut world, 0.1);
+
+        for (now, then) in speeds(&world).iter().zip(before) {
+            assert!(*now < then * 0.7, "{now} vs {then}");
+        }
+    }
+}
