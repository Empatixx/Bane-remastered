+    let rgb = srgb_to_linear(SHADOW_TINT * depth);
+    let rimmed = outlined(vec4<f32>(rgb, alpha), in, uv_per_pixel);
+    return vec4<f32>(rimmed.rgb, rimmed.a * in.color.a);
