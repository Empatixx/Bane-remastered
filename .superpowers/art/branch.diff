+    let texel = textureSampleLevel(image, image_sampler, in.uv, 0.0);
+    if (texel.a < 0.5) {
+        return vec4<f32>(0.0);
+    }
+    let time = in.fx.x;
+    let step = 1.0 / vec2<f32>(textureDimensions(image));
+    let cell = floor(in.uv / step);
