+    if (!shadow_solid(in.uv + vec2<f32>(0.0, step.y), in)) { edge = edge + 1.0; }
+    if (!shadow_solid(in.uv - vec2<f32>(0.0, step.y), in)) { edge = edge + 1.0; }
+    let flicker = noise(cell + vec2<f32>(floor(time * 10.0) * 3.1, 0.7));
+    if (edge > 0.5) {
+        if (flicker < 0.25 + edge * 0.12) {
+            return vec4<f32>(0.0);
+        }
+        alpha = alpha * 0.6;
+    } else if (flicker > 0.97) {
+        alpha = alpha * 0.5;
+    }
