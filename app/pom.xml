<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cz.empatix</groupId>
        <artifactId>bane-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>Bane</artifactId>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <mainClass>cz.empatix.BaneApplication</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>cz.empatix.BaneApplication</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.7.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>proguard</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <proguardConfiguration>
                        ./proguard.conf
                    </proguardConfiguration>
                    <!-- Internal engine modules are already merged into the shaded jar by
                         maven-shade-plugin, so exclude them from ProGuard's library jars to
                         avoid "duplicate definition of library class" conflicts. -->
                    <exclusions>
                        <exclusion>
                            <groupId>cz.empatix</groupId>
                            <artifactId>game-engine-core</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>cz.empatix</groupId>
                            <artifactId>game-engine-physics</artifactId>
                        </exclusion>
                    </exclusions>
                </configuration>
                <dependencies>
                    <!-- Override the ProGuard version bundled with the plugin so it can read
                         modern (Java 25) class files. -->
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>7.9.1</version>
                    </dependency>
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-core</artifactId>
                        <version>9.3.2</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

